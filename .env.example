# Copy to .env and fill in. Never commit .env.
SESSION_SECRET=
SESSION_SECURE=false
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://localhost:8009
# Optional: seed the first admin account on an empty database
#ADMIN_USERNAME=
#ADMIN_EMAIL=
#ADMIN_PASSWORD=

# Chronicle creation-rule enforcement. Unset/0: violations are reported to the client and logged but saves go through.
# 1: non-draft saves that break a chronicle's rules are rejected (Storyteller/admin can pass override: true).
RULES_ENFORCE=0

# Sign in with Discord (optional). Create an application at https://discord.com/developers/applications,
# add this redirect under OAuth2: <APP_URL>/api/auth/discord/callback  (or set DISCORD_REDIRECT_URI to match exactly).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
#DISCORD_REDIRECT_URI=

# Discord bot for session mode (optional). Uses the same Discord application as sign-in above
# (DISCORD_CLIENT_ID doubles as the application id). From the application's pages:
#   Bot > Reset Token                 -> DISCORD_BOT_TOKEN   (secret; never commit it)
#   General Information > Public Key  -> DISCORD_PUBLIC_KEY
#   General Information > Interactions Endpoint URL -> <APP_URL>/api/discord/interactions
# Then register the slash commands once: see README, "Discord bot".
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
